# file-cleaner configuration. Copy to config/file-cleaner.conf (git-ignored)
# or point FC_CONFIG / -c at your own file. This file is sourced by bash.
# Never put tokens here — export FC_GIT_TOKEN in the environment instead.

# Work branch created in every repository.
# FC_BRANCH="file-cleaner/remove-license-headers"

# Commit message, MR title and MR description.
# FC_COMMIT_MESSAGE="chore: remove obsolete license headers"
# FC_MR_TITLE="$FC_COMMIT_MESSAGE"
# FC_MR_DESCRIPTION="Automated cleanup by file-cleaner."

# Leading comment blocks are removed only when they match this ERE.
# Matching is case-insensitive (the header text is lowercased first), so
# write the pattern in lowercase.
# FC_HEADER_PATTERN="copyright|all rights reserved|licensed under|spdx-license-identifier"

# Lines containing these literal markers delimit snippets to delete
# (inclusive), in any language.
# FC_SNIPPET_BEGIN="FILE-CLEANER: BEGIN-REMOVE"
# FC_SNIPPET_END="FILE-CLEANER: END-REMOVE"

# Restrict to some types (comma-separated). Empty = all supported types.
# FC_TYPES="shell,python,javascript"

# Space-separated directory names never descended into.
# FC_EXCLUDE_DIRS=".git node_modules vendor dist build .venv"

# 1 = revert changes to files whose type has no validator installed.
# FC_REQUIRE_VALIDATOR=0

# Hosting provider: auto | github | gitlab | none. auto detects from the URL.
# FC_PROVIDER=auto
# Override the API base for self-hosted instances.
# FC_API_URL="https://gitlab.example.com/api/v4"

# Where repositories are cloned.
# FC_WORKDIR="/tmp/file-cleaner"

# Commit identity (defaults to the clone's git config).
# FC_GIT_AUTHOR_NAME="file-cleaner bot"
# FC_GIT_AUTHOR_EMAIL="file-cleaner@example.com"
